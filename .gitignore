# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

.pytest_cache/

# Virtual environments
.venv

# PoC data/outputs (large, regenerable via scripts/)
data/
# ...except the benchmark evidence. RESULT.md claims every number traces to a
# file here, which is only true if they ship: 172 KB of CSVs against 132 MB of
# checkpoints, plots and val dirs. Numbers only -- no weights, no images.
# Written as `runs/*` rather than `runs/`: git cannot re-include a path whose
# parent directory is itself excluded, so the negations below would never fire.
runs/*
!runs/bench_pi/
runs/bench_pi/*
!runs/bench_pi/*.csv
!runs/bench_pi/*.txt
# Built per run and rsynced to the Pi, not carried in git. The suffix patterns
# below miss .mnn and the ncnn/openvino model *directories*, so ignore the tree.
artifacts/
*.pt
*.onnx
*.tflite

# The Hailo Dataflow Compiler drops acceleras/allocator/hailo_sdk.* logs in the
# working directory, which is the repo root when hailo-compile.sh runs there.
# Covers the export/train/compile transcripts too.
*.log

# Autonumbered sweeps. out_paths() names these when the un-suffixed pair is
# taken, so the number says nothing about what was measured -- rename one to
# match its siblings (results_640_argbolts_n_4core.csv) before committing it.
runs/bench_pi/results_[0-9]*.csv
runs/bench_pi/conditions_[0-9]*.txt

# Regenerated by slides/build_slides.py from the committed benchmark CSV.
slides/*.pptx
slides/preview.pdf

.env
.mcp.json
.DS_Store
